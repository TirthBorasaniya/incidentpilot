GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL=#incidents

LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
# use https://us.cloud.langfuse.com if your Langfuse project is on the US region
LANGFUSE_HOST=https://cloud.langfuse.com

# required, docker compose fails loudly if this is unset
GRAFANA_ADMIN_PASSWORD=choose_a_local_grafana_password

PROMETHEUS_URL=http://prometheus:9090
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=runbooks

LOG_DIR=/app/logs
DB_PATH=/app/data/incidents.db

MAX_AGENT_ITERATIONS=5
